#include <stdio.h>
#include <stdbool.h>
#include <string.h>

// Definições de constantes
#define TAMANHO_TABULEIRO 10
#define TAMANHO_NAVIO 3
#define AGUA 0
#define NAVIO 3

// Função para inicializar o tabuleiro com água (0)
void inicializarTabuleiro(int tabuleiro[TAMANHO_TABULEIRO][TAMANHO_TABULEIRO]) {
    for (int i = 0; i < TAMANHO_TABULEIRO; i++) {
        for (int j = 0; j < TAMANHO_TABULEIRO; j++) {
            tabuleiro[i][j] = AGUA;
        }
    }
}

// Verifica se as coordenadas são válidas
bool coordenadasValidas(int linha, int coluna, int tamanho, char orientacao) {
    if (linha < 0 || linha >= TAMANHO_TABULEIRO || coluna < 0 || coluna >= TAMANHO_TABULEIRO) {
        return false;
    }

    switch (orientacao) {
        case 'H': return (coluna + tamanho <= TAMANHO_TABULEIRO);
        case 'V': return (linha + tamanho <= TAMANHO_TABULEIRO);
        case 'D': return (linha + tamanho <= TAMANHO_TABULEIRO && coluna + tamanho <= TAMANHO_TABULEIRO);
        case 'A': return (linha + tamanho <= TAMANHO_TABULEIRO && coluna - tamanho + 1 >= 0);
        default: return false;
    }
}

// Verifica sobreposição
bool verificarSobreposicao(int tabuleiro[TAMANHO_TABULEIRO][TAMANHO_TABULEIRO],
                           int linha, int coluna, int tamanho, char orientacao) {
    for (int i = 0; i < tamanho; i++) {
        switch (orientacao) {
            case 'H':
                if (tabuleiro[linha][coluna + i] != AGUA) return true;
                break;
            case 'V':
                if (tabuleiro[linha + i][coluna] != AGUA) return true;
                break;
            case 'D':
                if (tabuleiro[linha + i][coluna + i] != AGUA) return true;
                break;
            case 'A':
                if (tabuleiro[linha + i][coluna - i] != AGUA) return true;
                break;
        }
    }
    return false;
}

// Posiciona navio
bool posicionarNavio(int tabuleiro[TAMANHO_TABULEIRO][TAMANHO_TABULEIRO],
                     int navio[], int linha, int coluna, int tamanho, char orientacao) {
    if (!coordenadasValidas(linha, coluna, tamanho, orientacao)) {
        printf("Erro: Coordenadas inválidas!\n");
        return false;
    }
    if (verificarSobreposicao(tabuleiro, linha, coluna, tamanho, orientacao)) {
        printf("Erro: Sobreposição de navio!\n");
        return false;
    }

    for (int i = 0; i < tamanho; i++) {
        switch (orientacao) {
            case 'H':
                tabuleiro[linha][coluna + i] = navio[i];
                break;
            case 'V':
                tabuleiro[linha + i][coluna] = navio[i];
                break;
            case 'D':
                tabuleiro[linha + i][coluna + i] = navio[i];
                break;
            case 'A':
                tabuleiro[linha + i][coluna - i] = navio[i];
                break;
        }
    }
    return true;
}

// Exibe tabuleiro com gráficos
void exibirTabuleiro(int tabuleiro[TAMANHO_TABULEIRO][TAMANHO_TABULEIRO]) {
    printf("\n===== TABULEIRO DE BATALHA NAVAL =====\n\n");

    // Cabeçalho das colunas
    printf("   ");
    for (int j = 0; j < TAMANHO_TABULEIRO; j++) {
        printf(" %2d ", j);
    }
    printf("\n");

    for (int i = 0; i < TAMANHO_TABULEIRO; i++) {
        printf("%2d ", i);
        for (int j = 0; j < TAMANHO_TABULEIRO; j++) {
            if (tabuleiro[i][j] == AGUA) {
                printf(" 🌊 ");
            } else if (tabuleiro[i][j] == NAVIO) {
                printf(" 🚢 ");
            } else {
                printf(" ?  ");
            }
        }
        printf("\n");
    }

    printf("\nLegenda: 🌊 = Água | 🚢 = Navio\n");
}

// Função principal
int main() {
    int tabuleiro[TAMANHO_TABULEIRO][TAMANHO_TABULEIRO];

    // Definindo os navios
    int navio_horizontal[TAMANHO_NAVIO] = {3, 3, 3};
    int navio_vertical[TAMANHO_NAVIO] = {3, 3, 3};
    int navio_diagonal1[TAMANHO_NAVIO] = {3, 3, 3};
    int navio_diagonal2[TAMANHO_NAVIO] = {3, 3, 3};

    // Coordenadas dos navios
    int navio1_linha = 1, navio1_coluna = 1;
    int navio2_linha = 5, navio2_coluna = 8;
    int navio3_linha = 2, navio3_coluna = 4;
    int navio4_linha = 6, navio4_coluna = 6;

    printf("=== INICIANDO BATALHA NAVAL ===\n");

    inicializarTabuleiro(tabuleiro);

    // Posicionando navios
    posicionarNavio(tabuleiro, navio_horizontal, navio1_linha, navio1_coluna, TAMANHO_NAVIO, 'H');
    posicionarNavio(tabuleiro, navio_vertical, navio2_linha, navio2_coluna, TAMANHO_NAVIO, 'V');
    posicionarNavio(tabuleiro, navio_diagonal1, navio3_linha, navio3_coluna, TAMANHO_NAVIO, 'D');
    posicionarNavio(tabuleiro, navio_diagonal2, navio4_linha, navio4_coluna, TAMANHO_NAVIO, 'A');

    // Exibindo tabuleiro
    exibirTabuleiro(tabuleiro);

    return 0;
}
